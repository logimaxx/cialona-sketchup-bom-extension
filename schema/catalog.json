{
    "$id": "https://cialona.local/schema/cialona-bom-catalog.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Cialona BOM Code Catalog",
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "items"],
    "properties": {
      "version": { "type": "string", "minLength": 1 },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "label", "uom"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 64 },
            "label": { "type": "string", "minLength": 1, "maxLength": 200 },
            "uom": { "type": "string", "enum": ["pcs", "m2", "m", "custom"] },
            "default_measure": {
              "type": "string",
              "enum": [
                "count",
                "top_area",
                "bottom_area",
                "total_area",
                "material_area",
                "top_perimeter",
                "bottom_perimeter",
                "edge_length",
                "smart_length",
                "bbox_volume",
                "bbox_dimensions"
              ]
            },
            "tags": { "type": "array", "items": { "type": "string" }, "default": [] }
          }
        }
      }
    }
  }
  