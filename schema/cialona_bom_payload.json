{
    "$id": "https://cialona.local/schema/cialona-bom-entity.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Cialona BOM Entity Attributes",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "items"],
    "properties": {
      "schema_version": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
        "default": "1.0"
      },
      "items": {
        "type": "array",
        "minItems": 0,
        "items": { "$ref": "#/$defs/BomItem" }
      }
    },
    "$defs": {
      "BomItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "uom", "measure", "params"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "label": {
            "type": "string",
            "minLength": 0,
            "maxLength": 200
          },
          "uom": {
            "type": "string",
            "enum": ["pcs", "m2", "m", "custom"]
          },
          "measure": {
            "type": "string",
            "enum": [
              "count",
              "top_area",
              "bottom_area",
              "total_area",
              "material_area",
              "top_perimeter",
              "bottom_perimeter",
              "edge_length",
              "smart_length",
              "bbox_volume",
              "bbox_dimensions"
            ]
          },
          "scope": {
            "type": "string",
            "enum": ["definition", "instance"],
            "default": "definition"
          },
          "multiplier": {
            "type": "number",
            "minimum": 0,
            "default": 1
          },
          "rounding": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": { "type": "string", "enum": ["none", "ceil", "floor", "round"], "default": "round" },
              "step": { "type": "number", "exclusiveMinimum": 0, "default": 0.01 }
            },
            "default": { "mode": "round", "step": 0.01 }
          },
          "params": {
            "type": "object",
            "additionalProperties": true,
            "default": {}
          }
        },
        "allOf": [
          {
            "if": { "properties": { "measure": { "const": "material_area" } }, "required": ["measure"] },
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "required": ["material"],
                  "properties": {
                    "material": { "type": "string", "minLength": 1 },
                    "include_back_faces": { "type": "boolean", "default": false }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "measure": { "const": "top_perimeter" } }, "required": ["measure"] },
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "properties": {
                    "include_holes": { "type": "boolean", "default": false }
                  }
                }
              }
            }
          },
          {
            "if": { "properties": { "measure": { "const": "bbox_dimensions" } }, "required": ["measure"] },
            "then": {
              "properties": {
                "uom": { "const": "custom" }
              }
            }
          }
        ]
      }
    }
  }
  